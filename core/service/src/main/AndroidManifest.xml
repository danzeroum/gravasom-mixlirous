<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application>
        <service
            android:name="com.gravasom.core.service.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name="com.gravasom.core.service.tile.RecordTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_btn_speak_now"
            android:label="Gravar"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- F8: tile "Criar versão" (atalho rápido para o fluxo de criação F6). -->
        <service
            android:name="com.gravasom.core.service.tile.CriarTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_media_play"
            android:label="Criar versão"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.gravasom.core.service.widget.RecordWidgetReceiver"
            android:exported="true"
            android:label="Gravar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/record_widget_info" />
        </receiver>
    </application>
</manifest>
